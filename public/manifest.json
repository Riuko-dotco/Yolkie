{
  "name": "Yolkie-Adblock",
  "version": "1.0",
  "manifest_version": 3,

  "permissions": [
    "declarativeNetRequest",
    "storage",
    "webRequest",
    "windows"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "service_worker": "src/background/index.js",
    "type": "module"
  },

  "action": {
    "default_popup": "src/background/yolkie-OptionsMenu.html"
  },

  "web_accessible_resources": [
    {
      "resources": [
        "src/games/dino-yolk/resources/*",
        "src/games/dino-yolk/resources/**/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "base_rules",
        "enabled": true,
        "path": "rules/adblock-rules.json"
      }
    ]
  }
}